# Required. Keep this file server-side.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Token constraints
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_EPHEMERAL_TOKEN_URL=https://generativelanguage.googleapis.com/v1beta/auth_tokens
SAFECALL_GEMINI_CONNECTION_TTL_SECONDS=1800
SAFECALL_GEMINI_NEW_SESSION_TTL_SECONDS=60

# Request boundary
SAFECALL_ALLOWED_CLIENT_ENVIRONMENTS=development
SAFECALL_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8082
SAFECALL_TRUSTED_PROXY_CIDRS=
SAFECALL_LIVE_TOKEN_RATE_LIMIT_REQUESTS=10
SAFECALL_LIVE_TOKEN_RATE_LIMIT_WINDOW_SECONDS=60

# Existing optional application settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=auth_db
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8081/login/oauth2/code/kakao
